#!/usr/bin/env bash
#MISE description="🏷️  Release step 1: open the pull request that sets a new version"
#USAGE arg "<version>" help="The new version: patch, minor, major, or x.y.z"
#
# Branches from origin/main, sets the version in package.json and
# package-lock.json, runs every check, then commits, pushes and opens the
# pull request. Merging it stays with a maintainer; then run
# `mise run release:publish`.
set -euo pipefail

version=${usage_version:?}
version=${version#v}
if [[ ! $version =~ ^(patch|minor|major|[0-9]+\.[0-9]+\.[0-9]+)$ ]]; then
  echo "Give the version as patch, minor, major, or x.y.z, not $version." >&2
  exit 2
fi
if [[ -n $(git status --porcelain --untracked-files=no) ]]; then
  echo "Commit or stash the changes in this checkout first." >&2
  exit 2
fi

git fetch --quiet origin main
current=$(git show origin/main:package.json | node -p 'JSON.parse(require("fs").readFileSync(0, "utf8")).version')
if [[ $version =~ ^(patch|minor|major)$ ]]; then
  version=$(node -p '
    const [maj, min, pat] = process.argv[1].split(".").map(Number);
    const type = process.argv[2];
    if (type === "major") `${maj + 1}.0.0`;
    else if (type === "minor") `${maj}.${min + 1}.0`;
    else `${maj}.${min}.${pat + 1}`;
  ' "$current" "$version")
else
  # shellcheck disable=SC2016 # JavaScript template literal, not a shell expansion.
  node -e '
    const [current, next] = process.argv.slice(1).map((v) => v.split(".").map(Number));
    const newer = next[0] - current[0] || next[1] - current[1] || next[2] - current[2];
    if (newer <= 0) {
      console.error(`${process.argv[2]} is not newer than ${process.argv[1]} on main.`);
      process.exit(2);
    }
  ' "$current" "$version"
fi

branch=chore/release-$version
git switch --quiet --no-track --create "$branch" origin/main
npm version "$version" --no-git-tag-version
mise run check
git commit --quiet --message "chore: release $version" -- package.json package-lock.json
git push --quiet --set-upstream origin "$branch"
gh pr create --base main --head "$branch" --title "chore: release $version" --body "Sets the package to $version for a release.

After merging, run \`mise run release:publish\`, then \`mise run release:approve\` (CONTRIBUTING.md, \"Releases\")."

echo
echo "Next: merge the pull request, then run: mise run release:publish"
